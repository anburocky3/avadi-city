{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "deny",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "react", "nextjs"],
  "rules": {
    "react/jsx-key": "error",
    "react/no-unknown-property": "error",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "generated"
  ]
}
