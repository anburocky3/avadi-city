enum Gender {
  Male
  Female
  Other
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  gender              Gender
  dob                 DateTime
  bloodGroup          BloodGroup
  phone               String              @unique
  avatar              String?             @db.LongText
  email               String              @unique
  password            String?
  wardNumber          Int
  streetName          String
  notificationEnabled Boolean             @default(false)
  isVerified          Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  feeds               Feed[]
  comments            Comment[]
  likes               FeedLike[]
  submissions         ContactSubmission[]

  @@index([wardNumber])
  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, otp])
  @@index([email])
  @@map("verification_tokens")
}