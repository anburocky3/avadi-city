enum Gender {
  Male
  Female
  Other
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  gender              Gender
  dob                 DateTime
  bloodGroup          BloodGroup          @map("blood_group")
  phone               String              @unique
  avatar              String?             @db.LongText
  email               String              @unique
  password            String?
  wardNumber          Int                 @map("ward_number")
  streetName          String              @map("street_name")
  notificationEnabled Boolean             @default(false) @map("notification_enabled")
  isVerified          Boolean             @default(true) @map("is_verified")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  // Relations
  feeds               Feed[]
  comments            Comment[]
  likes               FeedLike[]
  submissions         ContactSubmission[]
  complaints          Complaint[]
  complaintUpvotes    ComplaintUpvote[]   // Required reverse relation for ComplaintUpvote.user
  lostFoundItems      LostFoundItem[]
  claimRequests       LostFoundClaim[]    @relation("ClaimRequests")  // Claims sent by this user
  claimOwnership      LostFoundClaim[]    @relation("ClaimOwnership") // Claims received by this user (as item owner)
  foodListings        FoodListing[]
  foodReviews         FoodReview[]
  foodFavorites       FoodFavorite[]
  foodRecentlyViewed  FoodRecentlyViewed[]
  healthcareFacilities HealthcareFacility[]
  jobVacancies        JobVacancy[]
  jobApplications     JobApplication[]
  explorePlaces       ExplorePlace[]
  placeReviews        PlaceReview[]
  volunteers          Volunteer[]
  donations           DonationRequest[]
  supportTickets      SupportTicket[]

  @@index([wardNumber])
  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, otp])
  @@index([email])
  @@map("verification_tokens")
}