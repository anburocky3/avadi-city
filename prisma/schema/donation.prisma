model DonationRequest {
  id                      String           @id @default(cuid())
  displayId               String           @unique @map("display_id") // Formatted ID e.g., AVC-DON-0001
  userId                  String?          @map("user_id")
  user                    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByName           String?          @map("created_by_name")
  
  type                    String           // "Charity Need" | "Emergency Relief" | "Blood Requirement" etc.
  urgency                 String           // "Normal" | "Urgent" | "Critical"
  title                   String
  description             String?          @db.Text
  ward                    Int
  address                 String           @db.Text
  lat                     Float?
  lng                     Float?
  beneficiary             String           @default("Individual") // "Individual" | "Family" | "Community or Institution"
  
  // Items needed (array of { id, name, qty, unit })
  items                   Json?

  // Financial target
  target                  Json?            // { amount?: number | string, upi?: string }

  requiredBy              String?          @map("required_by") // YYYY-MM-DD
  
  // Contact details
  contactName             String           @map("contact_name")
  contactPhone            String           @map("contact_phone")
  contactWhatsapp         String           @map("contact_whatsapp")

  images                  Json?            // string[] image URLs
  organisation            Json?            // { name?: string, regNo?: string }
  supportingProof         String?          @db.Text @map("supporting_proof")
  
  status                  String           @default("approved") // "pending" | "approved" | "fulfilled" | "closed" | "rejected"

  reports                 DonationReport[]

  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@index([ward])
  @@index([status])
  @@index([type])
  @@index([urgency])
  @@index([userId])
  @@index([displayId])
  @@map("donation_requests")
}

model DonationReport {
  id          String          @id @default(cuid())
  donationId  String          @map("donation_id")
  donation    DonationRequest @relation(fields: [donationId], references: [id], onDelete: Cascade)
  reason      String
  details     String?         @db.Text
  reportedBy  String?         @map("reported_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([donationId])
  @@map("donation_reports")
}
