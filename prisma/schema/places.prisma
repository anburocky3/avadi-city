model ExplorePlace {
  id                String   @id @default(cuid())
  name              String
  category          String
  description       String   @db.Text
  address           String   @db.Text
  areaLandmark      String?
  ward              Int
  latitude          Float?
  longitude         Float?

  // Timings & Entry
  is24x7            Boolean  @default(false)
  openingTime       String?
  closingTime       String?
  entryFeeType      String   @default("Free Entry") // "Free Entry" | "Paid Entry"
  entryFeeAmount    Float?

  // Media
  imageUrl          String?  @db.Text
  additionalImages  Json?

  // Details & Visitor info
  activities        Json?
  visitorTypes      Json?
  facilities        Json?
  bestTimeToVisit   String?
  guidelines        String?  @db.Text
  phone             String?
  website           String?
  officialUrl       String?
  additionalDetails String?  @db.Text

  // Moderation & Ownership
  status            String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  ownerId           String
  user              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ward])
  @@index([category])
  @@index([status])
  @@index([ownerId])
  @@map("explore_places")
}

model PlaceReview {
  id         String   @id @default(cuid())
  placeId    String
  userId     String
  rating     Int      // 1 to 5
  reviewText String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([placeId])
  @@index([userId])
  @@map("place_reviews")
}
