enum InquiryCategory {
  technical
  collaboration
  feedback
  civic_issue
}

enum SubmissionStatus {
  pending
  in_progress
  resolved
  closed
}

model ContactSubmission {
  id         Int              @id @default(autoincrement())
  userId     String?          // Optional link to registered resident account
  fullName   String
  email      String
  phone      String?          @db.VarChar(15)
  category   InquiryCategory
  wardNumber Int?
  message    String           @db.Text
  status     SubmissionStatus @default(pending)
  
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, status])
  @@index([wardNumber])
  @@index([userId])
  @@map("contact_submissions")
}

enum SupportFeatureCategory {
  EXPLORE_PLACES
  FOOD_DINING
  HOSPITALS_PHARMACIES
  LOCAL_SERVICES
  RENT_PROPERTIES
  JOB_VACANCIES
  DONATIONS
  TRAVEL_TRANSPORT
  LOST_FOUND
  SOS
  COMPLAINTS
  FEED
  PROFILE
  COMMERCE
  TRANSIT
  OTHER
}

enum SupportTicketStatus {
  OPEN
  REVIEWING
  RESOLVED
}

model SupportTicket {
  id              String                 @id @default(cuid())
  userId          String?
  featureCategory SupportFeatureCategory
  subCategory     String
  description     String                 @db.Text
  screenshotUrl   String?                @db.Text
  status          SupportTicketStatus    @default(OPEN)
  wardId          Int?

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([featureCategory, status])
  @@index([userId])
  @@index([wardId])
  @@map("support_tickets")
}