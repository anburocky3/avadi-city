model FoodListing {
  id                String   @id @default(cuid())
  name              String
  category          String
  description       String   @db.Text
  address           String
  ward              Int
  phone             String

  // Optional fields
  imageUrl          String?  @db.Text @map("image_url")
  openingTime       String?  @map("opening_time")
  closingTime       String?  @map("closing_time")
  foodType          String?  @map("food_type")
  priceRange        String?  @map("price_range")
  website           String?
  additionalDetails String?  @db.Text @map("additional_details")

  // Moderation & Ownership
  status          ApprovalStatus @default(PENDING)
  ownerId           String   @map("owner_id")
  user              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([ward])
  @@index([category])
  @@index([status])
  @@index([ownerId])
  @@map("food_listings")
}

model FoodReview {
  id         String   @id @default(cuid())
  shopId     String   @map("shop_id")
  userId     String   @map("user_id")
  rating     Int      // 1 to 5
  reviewText String?  @db.Text @map("review_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("food_reviews")
}

model FoodFavorite {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("food_favorites")
}

model FoodRecentlyViewed {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  userId    String   @map("user_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@index([viewedAt])
  @@map("food_recently_viewed")
}
