model FoodListing {
  id                String   @id @default(cuid())
  name              String
  category          String
  description       String   @db.Text
  address           String
  ward              Int
  phone             String

  // Optional fields
  imageUrl          String?  @db.Text
  openingTime       String?
  closingTime       String?
  foodType          String?
  priceRange        String?
  website           String?
  additionalDetails String?  @db.Text

  // Moderation & Ownership
  status            String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  ownerId           String
  user              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ward])
  @@index([category])
  @@index([status])
  @@index([ownerId])
  @@map("food_listings")
}

model FoodReview {
  id         String   @id @default(cuid())
  shopId     String
  userId     String
  rating     Int      // 1 to 5
  reviewText String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("food_reviews")
}

model FoodFavorite {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("food_favorites")
}

model FoodRecentlyViewed {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  viewedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@index([viewedAt])
  @@map("food_recently_viewed")
}

