model JobVacancy {
  id                 String         @id @default(cuid())
  role               String         // Job Title
  category           String         // Job Category
  jobType            String         @map("job_type") // Employment Type: Full-Time, Part-Time, etc.
  workMode           String         @default("On-site") @map("work_mode") // On-site, Hybrid, Remote
  experience         String         // Fresher, 1-3 Years, etc.
  salary             String         // Formatted salary string e.g. ₹15,000 - ₹25,000 / month
  minSalary          Int?           @map("min_salary")
  maxSalary          Int?           @map("max_salary")
  salaryType         String?        @default("Per Month") @map("salary_type")

  // Company Details
  businessName       String         @map("business_name") // Company / Employer Name
  companyDescription String?        @db.Text @map("company_description")
  details            String         @db.Text // Job Description
  requirements       String?        @db.Text // JSON string array of skills/requirements
  qualifications     String?
  openings           Int            @default(1)
  gender             String?        @default("Any")
  minAge             Int?           @map("min_age")
  maxAge             Int?           @map("max_age")

  // Location
  location           String         // Area / Street
  ward               Int
  address            String         @db.Text // Detailed Address
  latitude           Float?
  longitude          Float?
  workingDays        String?        @db.Text @map("working_days")
  shift              String?        // Working Hours e.g. "9:00 AM - 6:00 PM"

  // Application
  applicationMethods String?        @map("application_methods") // JSON string array e.g. ["Phone", "Email"]
  contact            String         // Phone
  email              String?
  website            String?
  interviewAddress   String?        @db.Text @map("interview_address")
  interviewContactPerson String?     @map("interview_contact_person")
  interviewDate      String?         @map("interview_date")
  interviewTime      String?         @map("interview_time")
  deadline           String?        // Application deadline
  startDate          String?        @map("start_date") // Joining date
  imageUrl           String?        @db.Text @map("image_url")
  additionalInfo     String?        @db.Text @map("additional_info")
  featured           Boolean        @default(false)

  // Status & Ownership
  status             ApprovalStatus @default(PENDING)
  ownerId            String         @map("owner_id")
  user               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications       JobApplication[]

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([ward])
  @@index([category])
  @@index([jobType])
  @@index([status])
  @@index([featured])
  @@index([ownerId])
  @@map("job_vacancies")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

model JobApplication {
  id              String            @id @default(cuid())
  jobId           String            @map("job_id")
  job             JobVacancy        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId     String?           @map("applicant_id")
  user            User?             @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  fullName        String            @map("full_name")
  email           String
  phone           String
  resumeUrl       String            @db.Text @map("resume_url")
  resumeFileName  String?           @map("resume_file_name")

  coverLetter     String?            @db.Text @map("cover_letter")
  qualification   String?
  experience      String?           @db.Text
  skills          String?           @db.Text
  portfolioUrl    String?           @map("portfolio_url")

  status          ApplicationStatus @default(SUBMITTED)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([jobId])
  @@index([applicantId])
  @@index([email])
  @@index([status])
  @@map("job_applications")
}
