model Volunteer {
  id                      String      @id @default(cuid())
  displayId               String      @unique @map("display_id") // Formatted ID e.g., AVC-VOL-0001
  userId                  String?     @map("user_id")
  user                    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName                String      @map("full_name")
  ward                    Int
  gender                  String
  age                     Int
  dob                     String?
  
  // Contact
  mobile                  String
  whatsapp                String
  area                    String
  showPhonePublic         Boolean     @default(true) @map("show_phone_public")

  // Emergency Contact
  emergencyName           String      @map("emergency_name")
  emergencyPhone          String      @map("emergency_phone")
  emergencyRelationship   String      @map("emergency_relationship")

  // Profile details & Preferences (stored as JSON for structured data in MySQL)
  languages               Json        // string[]
  interests               Json        // string[]
  skills                  Json        // string[]
  otherSkill              String?     @map("other_skill")
  experience              String      // "Beginner" | "Intermediate" | "Experienced"
  bio                     String?     @db.Text
  vehicle                 String      // "None" | "Two-wheeler" | "Four-wheeler"

  // Availability (stored as JSON)
  // { days: string[], slots: string[], type: string, radius: string }
  availability            Json

  // Health
  bloodGroup              String      @map("blood_group")
  willDonateBlood         Boolean     @default(false) @map("will_donate_blood")
  lastDonation            String?     @map("last_donation")
  fitness                 String      @default("Yes") // "Yes" | "Limited"
  conditions              String?     @db.Text

  // Guardian for minors
  guardian                Json?       // { name: string, consent: boolean } | null

  // Consents
  conductConsent          Boolean     @default(true) @map("conduct_consent")
  directoryConsent        Boolean     @default(true) @map("directory_consent")
  truthfulConsent         Boolean     @default(true) @map("truthful_consent")

  status                  String      @default("pending") // "pending" | "active" | "approved" | "paused" | "left"

  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  @@index([ward])
  @@index([status])
  @@index([userId])
  @@index([displayId])
  @@map("volunteers")
}
