model LostFoundItem {
  id          String    @id @default(cuid())
  itemId      String    @unique @map("item_id") // Formatted tracking ID (e.g., LF-2026-482910)
  type        String    // "lost" | "found"
  title       String
  description String    @db.Text
  category    String    // "Wallet" | "Phone" | "Keys" | "Pet" | "Bag" | "Documents" | "Jewellery" | "Other"
  ward        Int       // Avadi municipal ward number (1–48)
  location    String    // Human-readable area/street description

  lostFoundDate String  @map("lost_found_date") // ISO date string of when item was lost or found
  lostFoundTime String? @map("lost_found_time") // Optional time string

  imageUrl    String?   @map("image_url") // Primary image URL (R2)
  imageUrls   Json?     @map("image_urls") // Array of up to 3 image URLs

  status      String    @default("Active") // "Active" | "Resolved"
  resolvedAt  DateTime? @map("resolved_at")

  // Contact — never returned in public listing; only via controlled reveal
  contactPhone String   @map("contact_phone") // Stored server-side; never exposed in listing API

  // Author
  contactName String    @map("contact_name") // Snapshot of user's display name at the time of submission
  userId      String    @map("user_id") // FK to User — every report must be authenticated
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Privacy-first contact: claims must be accepted before any phone is revealed
  claims      LostFoundClaim[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([ward])
  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([itemId])
  @@index([ward, type, status])
  @@map("lost_found_items")
}

// Claim / Match Request — requester must send a message; owner must accept before phones are shared
model LostFoundClaim {
  id          String        @id @default(cuid())

  // Item being claimed
  lostFoundItemId String        @map("lost_found_item_id")
  item            LostFoundItem @relation(fields: [lostFoundItemId], references: [id], onDelete: Cascade)

  // The person sending the claim (e.g., finder claiming a lost item, or owner claiming a found item)
  requesterId String             @map("requester_id")
  requester   User   @relation("ClaimRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  // The item poster (owner)
  ownerId     String             @map("owner_id")
  owner       User   @relation("ClaimOwnership", fields: [ownerId], references: [id], onDelete: Cascade)

  // Mandatory proof / identification note
  message     String @db.Text

  // Proof photo uploaded by claimant (R2 URL)
  imageUrl    String?            @map("image_url")

  // PENDING | ACCEPTED | REJECTED
  status      String @default("PENDING")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Prevent duplicate claims from same requester on same item
  @@unique([lostFoundItemId, requesterId])

  @@index([lostFoundItemId])
  @@index([requesterId])
  @@index([ownerId])
  @@index([status])
  @@map("lost_found_claims")
}
